# Pensyve gateway environment example
# Copy to .env and export the values in your shell or service configuration.
# The binaries read process environment variables, not .env files.
# Never commit .env files or real API keys.

# SQLite storage directory, not a database filename.
PENSYVE_PATH=./pensyve-data
PENSYVE_NAMESPACE=default

# Local HTTP gateway
HOST=127.0.0.1
PORT=3000

# Optional gateway authentication. Keys must start with psy_.
# Set your own key before exposing the gateway to other machines.
# PENSYVE_API_KEYS=psy_replace_with_your_key
# MCP_ALLOWED_HOSTS=memory.example.com

# Optional PostgreSQL backend. Leave unset to use SQLite.
# DATABASE_URL=postgres://user:password@localhost:5432/pensyve

# Optional Redis for caching, rate limiting, and daily quotas.
# Without Redis, the gateway uses an in-memory per-minute rate limit.
# REDIS_URL=redis://localhost:6379/0
# PENSYVE_RATE_LIMIT=30
# PENSYVE_DAILY_QUOTA=1000

# Optional prepared model cache. Use the same directory for both values.
# See docs/self-host.md for the model download command.
# HF_HOME=/absolute/path/to/pensyve-models
# FASTEMBED_CACHE_DIR=/absolute/path/to/pensyve-models

# Logging
RUST_LOG=info
