{
  "_comment": "Pensyve MCP configuration for Amazon Q Developer. Copy to .amazonq/mcp.json in your project root or home directory. Runs the local pensyve-mcp binary over stdio; no API key needed.",

  "mcpServers": {
    "pensyve": {
      "command": "pensyve-mcp",
      "args": ["--stdio"]
    }
  }
}
